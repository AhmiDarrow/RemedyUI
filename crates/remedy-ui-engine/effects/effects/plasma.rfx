// Plasma: flowing interference of waves through a cosine palette. Retro demoscene warmth;
// tune the palette to anything from candy to deep sea.
effect plasma(
    vec3 base = (0.45, 0.4, 0.6),
    vec3 swing = (0.35, 0.35, 0.35),
    vec3 rate = (1.0, 1.0, 1.0),
    vec3 phase = (0.3, 0.5, 0.7),
    float speed = 0.3 in 0..3,
    float zoom = 5.0 in 0.5..20,
) {
    fps 30;
    scale 0.35;

    pass waves {
        let t = time * speed;
        // A gentle warp, so the bands flow like liquid rather than ruled lines.
        let p = centered(uv) * zoom + (vec2(noise(uv * 3.0 + vec2(t * 0.4)), noise(uv * 3.0 + vec2(5.2, t * 0.4))) - 0.5) * 0.8;
        let v = sin(p.x + t) + sin((p.y + t) * 0.5) + sin((p.x + p.y + t) * 0.5)
            + sin(length(p + vec2(sin(t * 0.3), cos(t * 0.5)) * 2.0) + t);
        out = vec4(palette(v * 0.3 + t * 0.12, base, swing, rate, phase), 1.0);
    }
}
