// Confetti: paper bits in bright colours, falling, swaying and tumbling: a completed order,
// a level up, a birthday. Over anything.
effect confetti(
    float amount = 1.0 in 0..1,
    float speed = 1.0 in 0.1..3,
    float size_px = 4.0 in 1..12,
    float saturation = 0.75 in 0..1,
) {
    fps 30;
    scale 1.0;

    particles bits (count: 260, life: 5.0 / speed, splat: disc, blend: normal) {
        let x = rand(1.0) * size.x;
        let y = -20.0 + progress * (size.y + 40.0);
        let sway = sin(age * (1.5 + rand(3.0) * 2.0) + rand(4.0) * tau) * 18.0;
        // A strip seen turning: a capsule whose length and angle follow the spin.
        let spin = age * (3.0 + rand(5.0) * 6.0) + rand(6.0) * tau;
        pos = vec2(x + sway, y);
        radius = size_px * 0.45;
        color = vec4(hsv(rand(7.0), saturation, 1.0), step(rand(8.0), amount));
        trail = vec2(cos(spin), sin(spin * 0.7) * 0.35) * size_px * 1.6;
    }
}
