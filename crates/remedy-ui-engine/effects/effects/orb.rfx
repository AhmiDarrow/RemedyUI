// Orb: a raymarched 3D drop of liquid glass, slowly rippling over a dark floor, with studio
// reflections, an iridescent rim and a soft glow. Prism's 3D in one effect: camera, distance
// field, normals, GGX shading and an anti-aliased silhouette.
effect orb(
    color body = #6c5cff,
    color rim_color = #8ff7ff,
    color backdrop = #0b0d1a,
    float roughness = 0.22 in 0.05..1,
    float wobble = 0.12 in 0..0.5,
    float spin = 0.25 in 0..3,
) {
    fps 30;
    scale 1.0;

    // Broad, smooth ripples (waves, not noise, so the surface stays glassy and the march
    // converges). The result is scaled down so a step never passes through the surface.
    fn map(p: vec3) -> float {
        let a = sin(p.x * 2.3 + time * 0.9) * sin(p.y * 2.1 + time * 0.7) * sin(p.z * 2.5 - time * 0.5);
        let b = sin(dot(p, vec3(1.9, 2.7, -1.4)) + time * 1.1);
        return (sd_sphere(p, 1.0) - (a * 0.7 + b * 0.3) * wobble * 0.75) * 0.8;
    }

    // The surface's normal from four samples on a tetrahedron (instead of six on the axes).
    fn normal(p: vec3) -> vec3 {
        let e = 0.003;
        let a = vec3(1.0, -1.0, -1.0);
        let b = vec3(-1.0, -1.0, 1.0);
        let c = vec3(-1.0, 1.0, -1.0);
        let d = vec3(1.0, 1.0, 1.0);
        return normalize(a * map(p + a * e) + b * map(p + b * e) + c * map(p + c * e) + d * map(p + d * e));
    }

    pass scene {
        // The ripples turn with the camera; the floor is round about the same axis.
        let eye_w = vec3(0.0, 0.55, -3.6);
        let eye = rotate_y(eye_w, time * spin);
        let rd = rotate_y(camera_ray(uv, eye_w, vec3(0.0, -0.12, 0.0), 0.85), time * spin);

        // March in fixed steps, remembering where the ray came closest to the surface as an
        // angle: that gives the silhouette a smooth edge and the glow its shape.
        var t = 2.0;
        var near = 10.0;
        var tc = 2.0;
        for i in 0..40 {
            let h = map(eye + rd * t);
            let r = h / t;
            tc = r < near ? t : tc;
            near = min(near, r);
            t = min(t + h, 8.0);
        }
        let cover = 1.0 - smoothstep(0.0, 1.1 * texel / size.y, near);

        // Behind the orb: a halo, and a floor with its shadow and a pool of its colour.
        let halo = exp(-max(near, 0.0) * 11.0);
        let sky_col = backdrop.rgb + body.rgb * halo * 0.22;
        let tf = rd.y < -0.01 ? (-1.45 - eye.y) / rd.y : 40.0;
        let f = eye + rd * tf;
        let r2 = f.x * f.x + f.z * f.z;
        let floor_col = backdrop.rgb * (1.0 - 0.75 * exp(-r2 * 1.6)) + body.rgb * exp(-r2 * 0.45) * (1.0 - exp(-r2 * 1.8)) * 0.32;
        let back = mix(sky_col, floor_col, exp(-max(tf - 4.0, 0.0) * 0.32) * step(rd.y, -0.01));

        // The orb: deep colour inside, a studio reflected in it, iridescence at the edge.
        let p = eye + rd * tc;
        let n = normal(p);
        let v = -rd;
        let facing = saturate(dot(n, v));
        let l = rotate_y(normalize(vec3(-0.6, 0.75, -0.55)), time * spin);
        let l2 = rotate_y(normalize(vec3(0.85, 0.15, 0.1)), time * spin);
        let refl = reflect(rd, n);
        let wrap = saturate(dot(n, l) * 0.6 + 0.4);
        let base = mix(body.rgb * 0.06, body.rgb * 0.85, wrap * wrap);
        let inner = mix(body.rgb, rim_color.rgb, 0.35) * pow(facing, 3.0) * saturate(-dot(n, l) * 0.5 + 0.5) * 0.35;
        let studio = mix(backdrop.rgb, body.rgb * 0.7 + vec3(0.12), smoothstep(-0.25, 0.9, refl.y));
        let boxes = vec3(1.0) * pow(saturate(dot(refl, l)), 48.0) * 0.9 + rim_color.rgb * pow(saturate(dot(refl, l2)), 14.0) * 0.55;
        let edge = pow(1.0 - facing, 2.6);
        let sheen = mix(vec3(1.0, 0.35, 0.8), rim_color.rgb, saturate(n.y * 0.7 + 0.5));
        let spec = ggx(n, l, v, roughness, 0.05);
        let lit = base + inner + studio * (0.12 + 0.6 * edge) + boxes + sheen * edge * 0.85 + vec3(spec) * 0.8;
        out = vec4(mix(back, aces(lit * 0.95), cover), 1.0);
    }
}
