// CRT overlay: scanlines, an aperture-grille mask, a slow rolling bar, flicker and a dark
// rounded vignette, over whatever is under the element (text included). Retro, arcade and
// radio themes. Blend multiply for a real tube's darkening, or normal.
effect crt(
    float scanlines = 0.35 in 0..1,
    float mask = 0.25 in 0..1,
    float roll = 0.15 in 0..1,
    float flicker = 0.04 in 0..0.3,
    float curvature = 0.12 in 0..0.5,
) {
    fps 30;
    scale 1.0;
    blend multiply;

    pass glass {
        let q = barrel(uv, curvature);
        let inside = step(0.0, q.x) * step(q.x, 1.0) * step(0.0, q.y) * step(q.y, 1.0);
        let line = 1.0 - scanlines * (0.5 + 0.5 * cos(px.y * pi));
        let k = mod(floor(px.x), 3.0);
        let grille = mix(vec3(1.0), vec3(step(k, 0.5), step(abs(k - 1.0), 0.5), step(1.5, k)) * 0.6 + vec3(0.55), mask);
        let bar = 1.0 - roll * exp(-pow((fract(q.y - time * 0.08) - 0.5) * 9.0, 2.0)) * 0.6;
        let fl = 1.0 - flicker * noise(vec2(time * 30.0, 0.5));
        let edge = smoothstep(0.0, 0.03, min(min(q.x, 1.0 - q.x), min(q.y, 1.0 - q.y)));
        out = vec4(grille * line * bar * fl * edge * inside, 1.0);
    }
}
