## ページ。
page-number = { $page } ページ
pages-list = ページ
page-view-value = { $page } / { $count } ページ、{ $zoom }%

annotation-kind = { $kind ->
    [highlight] ハイライト
    [underline] 下線
    [strikeout] 取り消し線
    [squiggly] 波線
    [drawing] 描画
    [note] メモ
    [text-box] テキストボックス
    [rectangle] 四角形
    [ellipse] 楕円
    [line] 直線
    [arrow] 矢印
   *[annotation] 注釈
}
annotation-quoting = { $what }:「{ $text }」
annotation-with-comment = { $what }、コメント: { $comment }
annotation-by = { $what }、作成者: { $author }
annotation-selected = 選択中: { $description }
annotation-count = 注釈 { $count } 件:

