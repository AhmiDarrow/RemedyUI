## 页面。
page-number = 第 { $page } 页
pages-list = 页面
page-view-value = 第 { $page } 页，共 { $count } 页，{ $zoom }%

annotation-kind = { $kind ->
    [highlight] 高亮
    [underline] 下划线
    [strikeout] 删除线
    [squiggly] 波浪线
    [drawing] 绘图
    [note] 便笺
    [text-box] 文本框
    [rectangle] 矩形
    [ellipse] 椭圆
    [line] 直线
    [arrow] 箭头
    [image] 图片
   *[annotation] 批注
}
annotation-quoting = { $what }：“{ $text }”
annotation-with-comment = { $what }，评论：{ $comment }
annotation-by = { $what }，作者：{ $author }
annotation-selected = 已选中：{ $description }
annotation-count = { $count } 个批注：

