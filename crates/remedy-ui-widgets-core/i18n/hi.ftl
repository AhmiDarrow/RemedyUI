# The core widgets' own words. Placeholders ({ $name }) must stay; their order may change.
# Keyboard hints name keys as the keyboard prints them in the language (Esc, Umschalt…).

## Split panes, lamps, loading placeholders.
resize-panes = पेन का आकार बदलें
lamp-on = चालू
lamp-off = बंद
loading = लोड हो रहा है

## Secret fields.
show-password = पासवर्ड दिखाएं
hide-password = पासवर्ड छिपाएं

## Menus and the menu bar.
# The title for menus that do not fit in the menu bar (it shows "…").
menu-more = और
menu-bar-keys = F10 या Alt से मेन्यू बार पर जाएं; Alt और किसी मेन्यू के रेखांकित अक्षर से वह मेन्यू खुलता है
menu-title-keys = F10 से, या Alt और इसके रेखांकित अक्षर से, यह खुलता है
escape-closes = Esc दबाने पर यह बंद हो जाता है
context-menu-keys = Shift+F10 या मेन्यू कुंजी से वही मेन्यू खुलता है

## The trusted permission prompt.
prompt-deny = अस्वीकार करें
prompt-allow = अनुमति दें

## Steppers: { $label } is what the stepper sets ("Copies").
stepper-decrease = { $label } घटाएं
stepper-increase = { $label } बढ़ाएं

