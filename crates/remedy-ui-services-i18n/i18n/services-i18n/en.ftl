# The localization service's own words.

## Why typed text is not a number (shown under a number field).
decimal-empty = Enter a number
decimal-invalid = Not a number
# More than 38 significant digits or 28 decimal places.
decimal-overflow = Too many digits

## Languages by name, as a language menu lists them (CLDR's names, capitalized).
## `language-<code>` for a BCP 47 code; an app adds others with add_messages.
language-ar = Arabic
language-bn = Bangla
language-de = German
language-en = English
language-es = Spanish
language-fr = French
language-hi = Hindi
language-ja = Japanese
language-pt = Portuguese
language-ru = Russian
language-zh = Chinese
language-pt-BR = Brazilian Portuguese
language-zh-Hans = Simplified Chinese
