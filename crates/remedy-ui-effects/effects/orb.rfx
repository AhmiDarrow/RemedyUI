// Orb: a raymarched 3D sphere with a living, noise-displaced surface, lit by a key light,
// a rim and a soft environment, with real shadows and ambient occlusion, floating in fog.
// Prism's 3D in one effect: camera, distance field, normals, shadows and GGX shading.
effect orb(
    color body = #6c5cff,
    color rim_color = #8ff7ff,
    color backdrop = #0b0d1a,
    float roughness = 0.35 in 0.05..1,
    float wobble = 0.12 in 0..0.5,
    float spin = 0.25 in 0..3,
) {
    fps 30;
    scale 0.5;

    fn map(p: vec3) -> float {
        let q = rotate_y(p, time * spin);
        let n = fbm(q * 1.8 + vec3(0.0, time * 0.3, 0.0), 3);
        let ball = sd_sphere(p, 1.0) - (n - 0.5) * wobble * 2.0;
        let floor_plane = p.y + 1.35;
        return min(ball, floor_plane);
    }

    fn normal(p: vec3) -> vec3 {
        let e = 0.003;
        return normalize(vec3(
            map(p + vec3(e, 0.0, 0.0)) - map(p - vec3(e, 0.0, 0.0)),
            map(p + vec3(0.0, e, 0.0)) - map(p - vec3(0.0, e, 0.0)),
            map(p + vec3(0.0, 0.0, e)) - map(p - vec3(0.0, 0.0, e))
        ));
    }

    pass scene {
        let eye = vec3(sin(time * 0.1) * 0.6, 0.5, -3.4);
        let rd = camera_ray(uv, eye, vec3(0.0, -0.1, 0.0), 0.9);
        // March: fixed steps (no early exit, so every pixel costs the same).
        var t = 0.0;
        for i in 0..44 { t += map(eye + rd * t) * 0.95; }
        let p = eye + rd * t;
        let hit = step(map(p), 0.01) * step(t, 12.0);
        let n = normal(p);
        let l = normalize(vec3(-0.6, 0.8, -0.5));
        let v = -rd;
        // Soft shadow towards the light, and ambient occlusion along the normal.
        var sh = 1.0;
        var s = 0.05;
        for i in 0..10 { let h = map(p + l * s); sh = min(sh, clamp(8.0 * h / s, 0.0, 1.0)); s += clamp(h, 0.04, 0.4); }
        var ao = 0.0;
        for i in 1..5 { let d = i * 0.12; ao += (d - map(p + n * d)) / d; }
        ao = clamp(1.0 - ao * 0.25, 0.0, 1.0);
        let is_ball = step(-1.3, p.y);
        let albedo = mix(vec3(0.08, 0.09, 0.14), body.rgb, is_ball);
        let diffuse = albedo * (lambert(n, l) * sh * 1.1 + 0.18 * ao);
        let spec = ggx(n, l, v, roughness, 0.06) * sh * is_ball;
        let rimlight = rim_color.rgb * rim(n, v, 3.0) * 0.9 * is_ball * ao;
        let lit = diffuse + vec3(spec) + rimlight;
        let col = fog(lit, backdrop.rgb, t, 0.06);
        out = vec4(mix(backdrop.rgb, aces(col * 1.2), hit), 1.0);
    }
}
