// Volumetric clouds: a slab of 3D cloud raymarched from below, with light scattered through
// it, drifting. A true 3D effect: parallax and depth come from the volume itself.
effect volumetric_clouds(
    color sky_low = #9fc4e8,
    color sky_high = #3d6fb0,
    color sunlight = #fff2d9,
    float cover = 0.55 in 0..1,
    float speed = 0.15 in 0..2,
) {
    fps 15;
    scale 0.25;

    fn cloud(p: vec3) -> float {
        let q = p + vec3(time * speed, 0.0, time * speed * 0.4);
        let n = fbm(q * 0.35, 4);
        // A slab between heights 2 and 4, thinner at its edges.
        let slab = smoothstep(2.0, 2.6, p.y) * smoothstep(4.2, 3.4, p.y);
        return clamp((n - (1.0 - cover)) * 3.0, 0.0, 1.0) * slab;
    }

    // The light probe: the same cloud without its finest octave.
    fn cloud_light(p: vec3) -> float {
        let q = p + vec3(time * speed, 0.0, time * speed * 0.4);
        let n = fbm(q * 0.35, 3);
        let slab = smoothstep(2.0, 2.6, p.y) * smoothstep(4.2, 3.4, p.y);
        return clamp((n - (1.0 - cover)) * 3.0, 0.0, 1.0) * slab;
    }

    pass sky {
        let rd = camera_ray(uv, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.55, 1.0), 1.1);
        let sun = normalize(vec3(-0.4, 0.5, 0.8));
        var col = sky(rd, sky_low.rgb, sky_high.rgb) + sunlight.rgb * pow(max(dot(rd, sun), 0.0), 64.0);
        // March through the slab: front to back, accumulating colour and opacity.
        let t0 = 2.0 / max(rd.y, 0.05);
        let dt = 2.4 / max(rd.y, 0.05) / 24.0;
        var trans = 1.0;
        var light = vec3(0.0);
        // The last two steps (above 4.2) are past the slab's top: nothing there.
        for i in 0..24 {
            let p = rd * (t0 + dt * (i + 0.5));
            let d = cloud(p);
            let lit = clamp(d - cloud_light(p + sun * 0.4), 0.0, 1.0);
            let c = mix(vec3(0.62, 0.68, 0.78), sunlight.rgb, 0.4 + lit * 1.5);
            let a = 1.0 - exp(-d * dt * 1.2);
            light += c * a * trans;
            trans *= 1.0 - a;
        }
        col = col * trans + light;
        out = vec4(fog(col, sky_low.rgb, t0 * 0.02, 1.0), 1.0);
    }
}
