// Mesh gradient: four soft pools of colour drifting and melting into each other, the
// backdrop of hero sections, sign-in screens and cards. Opaque.
effect mesh_gradient(
    color a = #ff7eb3,
    color b = #7afcff,
    color c = #feff9c,
    color d = #a78bfa,
    float speed = 0.12 in 0..2,
    float softness = 0.55 in 0.1..2,
) {
    fps 24;
    scale 0.2;
    still 4.0;

    fn pool(p: vec2, at: vec2) -> float {
        let q = (p - at) * vec2(aspect, 1.0);
        return exp(-dot(q, q) / (softness * softness * 0.3));
    }

    pass mesh {
        let t = time * speed;
        // A slow warp, so the pools' edges bend instead of staying round.
        let p = uv + (vec2(noise(uv * 1.7 + vec2(t, 0.0)), noise(uv * 1.7 + vec2(4.0, t))) - 0.5) * 0.3;
        let wa = pool(p, vec2(0.2 + 0.15 * sin(t * 1.3), 0.25 + 0.12 * cos(t * 1.1)));
        let wb = pool(p, vec2(0.8 + 0.12 * cos(t * 0.9), 0.3 + 0.15 * sin(t * 1.7)));
        let wc = pool(p, vec2(0.3 + 0.15 * cos(t * 1.5), 0.8 + 0.1 * sin(t * 0.8)));
        let wd = pool(p, vec2(0.75 + 0.1 * sin(t * 1.2), 0.75 + 0.15 * cos(t * 1.4)));
        let total = wa + wb + wc + wd + 0.0001;
        out = vec3((a.rgb * wa + b.rgb * wb + c.rgb * wc + d.rgb * wd) / total);
    }
}
