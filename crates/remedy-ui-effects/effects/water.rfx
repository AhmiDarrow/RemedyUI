// Water: a moving surface seen from above at a slant: long swells and fine ripples that
// travel with the current, the sky reflected more towards the horizon, the bed's caustics
// showing through the clear parts, and sun glints twinkling on the crests. Rivers,
// harbours, ponds, an aquarium's surface. `flow` sets the current's direction and speed.
effect water(
    color deep = #0a3350,
    color shallow = #2a8696,
    color sky_tint = #a9d4ea,
    color glint = #ffffff,
    vec2 flow = (0.05, 0.012),
    float scale_px = 160.0 in 20..800,
    float chop = 0.7 in 0..1.5,
    float caustics = 0.45 in 0..1,
    float glints = 0.8 in 0..2,
) {
    fps 24;
    scale 0.5;

    fn height(p: vec2) -> float {
        let swell = fbm(p * 0.6 + flow * time * 2.0, 3);
        let ripple = fbm(p * 2.3 - flow.yx * time * 6.0 + vec2(7.0, 3.0), 3);
        return swell * 0.7 + ripple * 0.3;
    }

    pass surface {
        // Squash vertically: the surface recedes towards the top.
        let p = vec2(px.x, px.y * 1.8) / scale_px;
        let h = height(p);
        let e = 0.03;
        let n = normalize(vec3((height(p - vec2(e, 0.0)) - h) * chop * 22.0, (height(p - vec2(0.0, e)) - h) * chop * 22.0, 1.0));
        // Depth colour, with the swells lifting the shallows.
        var rgb = mix(deep.rgb, shallow.rgb, smoothstep(0.3, 0.75, h));
        // Caustics on the bed: thin bright lines where cells meet, bent by the surface.
        let c = voronoi(p * 1.7 + n.xy * 0.5 + flow * time * 4.0);
        let lines = 1.0 - smoothstep(0.0, 0.12, c.y - c.x);
        rgb += shallow.rgb * lines * caustics * 0.5 * (1.0 - uv.y * 0.6);
        // The sky, reflected more at grazing angles (towards the top).
        let f = fresnel(1.0 - uv.y * 0.85 + n.y * 0.4, 0.04);
        rgb = mix(rgb, sky_tint.rgb, clamp(f * 1.3, 0.0, 0.7));
        // Glints: the sun caught by the steepest small facets, twinkling.
        let sun = normalize(vec3(0.3, -0.6, 0.75));
        let spec = pow(max(dot(reflect(-sun, n), vec3(0.0, 0.0, 1.0)), 0.0), 220.0);
        let twinkle = 0.5 + 0.5 * sin(time * 9.0 + hash(floor(px / 3.0)) * tau);
        rgb += glint.rgb * spec * glints * twinkle * 2.5;
        out = vec4(rgb, 1.0);
    }
}
