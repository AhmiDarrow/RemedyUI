## الإشارات.
mention-count = { $count ->
    [zero] لا يوجد أشخاص للإشارة إليهم
    [one] شخص واحد للإشارة إليه
    [two] شخصان للإشارة إليهما
    [few] { $count } أشخاص للإشارة إليهم
    [many] { $count } شخصًا للإشارة إليهم
   *[other] { $count } شخص للإشارة إليهم
}
mention-keys = يختار السهمان لأعلى ولأسفل، ويُشير Enter أو Tab، ويُغلق Esc

