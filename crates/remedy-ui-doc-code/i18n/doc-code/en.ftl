# The code views' own words. Placeholders ({ $name }) must stay; their order may change.

## A fold button beside a line that opens a block, read by screen readers. { $line } is the
## line's number.
code-fold-line = Fold line { $line }
code-unfold-line = Unfold line { $line }

## A diff's lines, read by screen readers: how the line changed, then its code ({ $text }).
code-diff-added = Added: { $text }
code-diff-removed = Removed: { $text }
code-diff-unchanged = Unchanged: { $text }
