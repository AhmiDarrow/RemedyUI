# The terminal's own words. Placeholders ({ $name }) must stay; their order may change.
# Keyboard hints name keys as the keyboard prints them in the language (Strg, Umschalt…).

# What screen readers call a terminal when the app does not name it.
terminal = Terminal
# The terminal's name with the title the program running in it set. { $label } is the
# terminal's name ("Terminal"), { $title } the title ("vim notes.txt").
terminal-titled = { $label }: { $title }
# Keyboard hint (the terminal takes the pointer for selecting text).
terminal-keys = Ctrl+Shift+A selects everything and Ctrl+Shift+C copies it
