carousel-keys = ক্যারোসেলে তীর কী, অথবা আগের ও পরের বোতাম
carousel-page-of = { $count }টির মধ্যে পৃষ্ঠা { $page }
carousel-previous = আগের পৃষ্ঠা
carousel-next = পরের পৃষ্ঠা
carousel-go-to-page = { $count }টির মধ্যে পৃষ্ঠা { $page }-এ যান
carousel-pause = বিরতি
carousel-play = চালান
carousel-pause-autoplay = স্বয়ংক্রিয় পৃষ্ঠা পরিবর্তন থামান
carousel-play-autoplay = স্বয়ংক্রিয় পৃষ্ঠা পরিবর্তন আবার চালু করুন
qr-described = QR কোড, সংস্করণ { $version }, ত্রুটি সংশোধন { $level }
qr-too-long = এই ত্রুটি সংশোধন স্তরে লেখাটি QR কোডের জন্য অনেক বড়
qr-bad-options = QR কোডের বিকল্পগুলি অনুমোদিত সীমার বাইরে
rating-value-stars =
    { $max ->
        [one] { $max }টির মধ্যে { $value }টি তারা
       *[other] { $max }টির মধ্যে { $value }টি তারা
    }
rating-value = { $max }-এর মধ্যে { $value } { $unit }
stepper-back = পিছনে
stepper-next = পরবর্তী
stepper-skip = এড়িয়ে যান
stepper-finish = শেষ করুন
stepper-progress = { $label }-এর অগ্রগতি
stepper-marker-completed = ধাপ { $step }: { $title }, সম্পন্ন
stepper-marker-current = ধাপ { $step }: { $title }, বর্তমান
stepper-marker-not-started = ধাপ { $step }: { $title }, শুরু হয়নি
stepper-marker-locked = ধাপ { $step }: { $title }, লক করা
stepper-step-of-titled = { $count }টির মধ্যে ধাপ { $step }: { $title }
stepper-step-of = { $count }টির মধ্যে ধাপ { $step }
swatch-cursor = { $name }, { $hex }, সারি { $row } কলাম { $column }
swatch-cursor-selected = { $name }, { $hex }, সারি { $row } কলাম { $column }, নির্বাচিত
