carousel-keys = مفاتيح الأسهم على العرض الدوّار، أو زرّا السابق والتالي
carousel-page-of = الصفحة { $page } من { $count }
carousel-previous = الصفحة السابقة
carousel-next = الصفحة التالية
carousel-go-to-page = الانتقال إلى الصفحة { $page } من { $count }
carousel-pause = إيقاف مؤقت
carousel-play = تشغيل
carousel-pause-autoplay = إيقاف التقليب التلقائي للصفحات مؤقتًا
carousel-play-autoplay = استئناف التقليب التلقائي للصفحات
qr-described = رمز QR، الإصدار { $version }، مستوى تصحيح الأخطاء { $level }
qr-too-long = هذا النص أطول من أن يسعه رمز QR بمستوى تصحيح الأخطاء هذا
qr-bad-options = خيارات رمز QR خارج النطاق المسموح به
rating-value-stars =
    { $max ->
        [zero] { $value } من { $max } نجمة
        [one] { $value } من نجمة واحدة
        [two] { $value } من نجمتين
        [few] { $value } من { $max } نجوم
        [many] { $value } من { $max } نجمة
       *[other] { $value } من { $max } نجمة
    }
rating-value = { $unit }: { $value } من { $max }
stepper-back = السابق
stepper-next = التالي
stepper-skip = تخطي
stepper-finish = إنهاء
stepper-progress = تقدّم { $label }
stepper-marker-completed = الخطوة { $step }: { $title }، مكتملة
stepper-marker-current = الخطوة { $step }: { $title }، الحالية
stepper-marker-not-started = الخطوة { $step }: { $title }، لم تبدأ
stepper-marker-locked = الخطوة { $step }: { $title }، مقفلة
stepper-step-of-titled = الخطوة { $step } من { $count }: { $title }
stepper-step-of = الخطوة { $step } من { $count }
swatch-cursor = { $name }، { $hex }، الصف { $row } العمود { $column }
swatch-cursor-selected = { $name }، { $hex }، الصف { $row } العمود { $column }، محدد
