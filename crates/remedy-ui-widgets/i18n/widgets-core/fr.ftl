dock-collapsed = { $label } (réduit)

## Secret fields.
show-password = Afficher le mot de passe
hide-password = Masquer le mot de passe

## Menus and the menu bar.
# The title for menus that do not fit in the menu bar (it shows "…").
menu-more = Plus
menu-bar-keys = F10 ou Alt mène à la barre de menus ; Alt et la lettre soulignée d’un menu l’ouvrent
menu-title-keys = F10, ou Alt et sa lettre soulignée, l’ouvre
escape-closes = Échap le ferme
context-menu-keys = Maj+F10 ou la touche Menu ouvre le même menu

