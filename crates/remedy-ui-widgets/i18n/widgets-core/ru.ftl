# The core widgets' own words. Placeholders ({ $name }) must stay; their order may change.
# Keyboard hints name keys as the keyboard prints them in the language (Esc, Umschalt…).

## Split panes, lamps, loading placeholders.
resize-panes = Изменить размер панелей
lamp-on = вкл.
lamp-off = выкл.
loading = Загрузка

## Docked panes: { $label } is the pane's name ("Plans").
dock-move = { $label }: переместить
dock-move-hint = { $label }: перетащите или нажмите Enter, чтобы закрепить с другой стороны
dock-collapsed = { $label } (свёрнуто)

## Secret fields.
show-password = Показать пароль
hide-password = Скрыть пароль

## Menus and the menu bar.
# The title for menus that do not fit in the menu bar (it shows "…").
menu-more = Ещё
menu-bar-keys = F10 или Alt — переход к строке меню; Alt и подчёркнутая буква меню открывают его
menu-title-keys = Открывается клавишей F10 или клавишей Alt с подчёркнутой буквой
escape-closes = Закрывается клавишей Esc
context-menu-keys = Shift+F10 или клавиша меню открывает то же меню

## Text field edit menu.
edit-cut = Вырезать
edit-copy = Копировать
edit-paste = Вставить
edit-select-all = Выбрать всё

## The trusted permission prompt.
prompt-deny = Запретить
prompt-allow = Разрешить

## Steppers: { $label } is what the stepper sets ("Copies").
stepper-decrease = { $label }: уменьшить
stepper-increase = { $label }: увеличить

