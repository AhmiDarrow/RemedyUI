# The stage widgets' own words. Placeholders ({ $name }) must stay; their order may change.

# The level meter beside a fader, read by screen readers. { $label } is the fader's name
# ("Music").
fader-level = { $label } level
# Keyboard hint for a stage with parallax (layers that shift with the pointer).
scene-parallax-keys = Parallax is decoration; nothing needs the pointer
# A timeline's description while it is scrolled away from its newest items.
timeline-scrolled-back = Scrolled back
