# The spelling menu's own words.

## Entries of the context menu on a misspelled word.
# Adds the word to the person's own dictionary.
spell-add-to-dictionary = অভিধানে যোগ করুন
# Stops marking the word until the app ends.
spell-ignore = উপেক্ষা করুন
# Shown when the checker has no corrections for the word.
spell-no-suggestions = কোনো পরামর্শ নেই
