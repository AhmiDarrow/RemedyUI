# The data widgets' own words. Placeholders ({ $name }) must stay; their order may change.
# Keyboard hints name keys as the keyboard prints them in the language (Strg, Umschalt…).

## Chat lists: the button that appears while reading older messages.
chat-jump-latest = 最新へ移動
# Shown on the button when messages arrived below.
chat-new-count = 新着 { $count } 件
# What a screen reader says for that button.
chat-new-spoken = 新着メッセージ { $count } 件、最新へ移動

## Icon grids.
grid-item-keys = 方向キーで項目間を移動し、Space キーと Shift キーで選択します
grid-keys = Shift キーと方向キーで範囲を選択し、Ctrl+A ですべて選択します
# Read with the grid's name: how many items it holds.
grid-count = { $count } 個の項目

## Property grids.
# The filter box; { $label } is the grid's name ("Properties").
property-filter = { $label } を絞り込む
property-none = 一致するプロパティはありません

## Tables.
# The field that edits a cell; { $column } is the column's title.
table-edit = { $column } を編集
table-row-keys = 方向キーで行間を移動し、Space キーと Shift キーで選択します
table-resize-keys = 見出しで Ctrl+← キーと Ctrl+→ キーを押すと列の幅を変更します
table-move-keys = Alt+Shift+← キーと Alt+Shift+→ キーで列を移動します
# Read after a column heading's name.
table-sorted-ascending = 昇順で並べ替え済み
table-sorted-descending = 降順で並べ替え済み
table-not-sorted = 並べ替えなし
# Read with the table's name: how many rows it holds.
table-count = { $count } 行

## Tree views.
# Why a move (by dragging, or cut and paste) did not happen.
tree-into-itself = 項目をそれ自身の中に移動することはできません
tree-not-folder = 項目はフォルダーにのみ移動できます
# Shown after an item whose children are loading.
tree-loading = 読み込み中…
# The same, as a screen reader says it.
tree-loading-spoken = 読み込み中
tree-keys = 方向キーで項目間を移動して開き、Ctrl+X の後に Ctrl+V を押すと移動します
